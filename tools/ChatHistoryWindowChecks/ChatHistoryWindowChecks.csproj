<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Linked production DTOs include unrelated fields only exercised by other suites. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Link the real room chat history window and wire DTO. -->
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="../../src/Session/ChatHistoryWindow.cs" Link="ChatHistoryWindow.cs" />
    <Compile Include="../../src/Core/PlayerCommunication.cs" Link="PlayerCommunication.cs" />
  </ItemGroup>
</Project>
