<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the production communication/visit tick implementations, not copies. -->
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="../../src/Session/PlayerChat.cs" Link="PlayerChat.cs" />
    <Compile Include="../../src/Session/CommunicationRateLimiter.cs" Link="CommunicationRateLimiter.cs" />
    <Compile Include="../../src/Session/PlayerVisits.cs" Link="PlayerVisits.cs" />
    <Compile Include="../../src/Core/PlayerCommunication.cs" Link="PlayerCommunication.cs" />
    <Compile Include="../../src/Core/PlayerFleetBattles.cs" Link="PlayerFleetBattles.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildBinPath)/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
